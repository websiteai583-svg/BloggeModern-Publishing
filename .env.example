# ==============================================================================
# BLOGGE PRODUCTION CONFIGURATION (.env.example)
# Copy this file to .env and fill in the values for your production environment.
# ==============================================================================

# Node Environment
NODE_ENV="production"

# DATABASE_URL: Centralized PostgreSQL/Supabase database URL for multi-instance Cloud Run persistence
# Strictly REQUIRED in production mode. Cloud Run containers are ephemeral and stateless, so the server will refuse to start without DATABASE_URL.
# (Development mode only falls back to local JSON data/db.json if DATABASE_URL is unset).
DATABASE_URL="postgresql://postgres:password@db.example.com:5432/blogge"

# GEMINI_API_KEY: Required for AI content generation, SEO, and translation
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: Base URL of your deployed application (used for password reset links & self-referencing)
APP_URL="https://your-domain.com"

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins in production
# Example: "https://your-domain.com,https://www.your-domain.com,capacitor://localhost"
ALLOWED_ORIGINS="https://your-domain.com,https://www.your-domain.com"

# ADMIN_EMAIL: The only email address granted Administrator authority across the platform
ADMIN_EMAIL="websiteai583@gmail.com"

# SESSION_SECRET: Cryptographically secure secret used to sign and verify HMAC-SHA256 session tokens
SESSION_SECRET="generate_a_minimum_32_byte_random_string_here"

# ADMIN_API_KEY: Secret key for server-to-server maintenance endpoints (optional)
ADMIN_API_KEY="optional_secure_maintenance_key_here"

# RESEND_API_KEY: Transactional email provider API key for password reset delivery
RESEND_API_KEY="re_123456789_your_resend_api_key"

# EMAIL_FROM: Sender email address used for outgoing transactional emails
EMAIL_FROM="Blogge <no-reply@your-domain.com>"

# Cloudinary Storage Configuration (Optional - falls back to local storage if unset)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_URL=""

# Firebase Authentication & Project Configuration
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_API_KEY="your_firebase_api_key"

# Client-Side Production API Endpoint (VITE_ prefixed)
# Configure with your direct public Cloud Run API URL or verified custom domain
# Note: Standalone Android APK connects directly to this endpoint. Never use AI Studio preview URLs.
VITE_API_URL="https://YOUR-CLOUD-RUN-SERVICE.run.app"

# Client-Side Firebase Environment Variables (VITE_ prefixed)
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_APP_ID="your_firebase_web_app_id"
VITE_FIREBASE_DATABASE_URL="https://your-firebase-project-id.firebaseio.com"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id"
